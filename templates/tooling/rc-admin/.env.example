FIREBASE_PROJECT_ID={{FIREBASE_PROJECT_ID}}
# Optional — service account JSON outside repo. If unset/missing, uses `firebase login` credentials.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/your-rc-admin-service-account.json
PORT=3847
# Optional: require X-Admin-Token header on /api/* routes
# ADMIN_TOKEN=change-me
# Optional: override the Firebase CLI OAuth client (defaults to the public
# firebase-tools client, so you normally do not need to set these).
# FIREBASE_CLI_CLIENT_ID=
# FIREBASE_CLI_CLIENT_SECRET=
